# Example environment file for docker-compose.
# Copy to `.env` at the repo root and fill in real values.
# docker-compose auto-loads a root `.env` and interpolates ${VAR} references.
# Do NOT commit the real `.env` (it is git-ignored).

# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=9012
CLIENT_ORIGIN=http://localhost:3000

# ─── JWT secrets (use long random strings) ────────────────────────────────────
TOKEN_SECRET=replace_with_strong_random_string
REFRESH_TOKEN_SECRET=replace_with_strong_random_string

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_gmail_app_password_here
EMAIL_FROM=Your App <your_email@example.com>

# ─── Postgres ─────────────────────────────────────────────────────────────────
PGHOST=db
PGPORT=5432
PGUSER=postgres
PGPASSWORD=replace_with_db_password
PGDATABASE=postgres
